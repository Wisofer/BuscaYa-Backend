@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Configuración Bimonetaria";
    ViewData["CurrentPage"] = "dev-tests";
    
    bool isAuto = ViewBag.Mode != "MANUAL";
    string modeLabel = ViewBag.Mode switch {
        "EURO" => "Euro BCV (€)",
        "BCV" => "Dólar Oficial BCV ($)",
        "PARALLEL" => "Dólar Paralelo ($)",
        _ => "Manual"
    };
    string modeColor = ViewBag.Mode switch {
        "EURO" => "text-indigo-600 bg-indigo-50",
        "BCV" => "text-emerald-600 bg-emerald-50",
        "PARALLEL" => "text-amber-600 bg-amber-50",
        _ => "text-blue-600 bg-blue-50"
    };
    
    decimal? barberManualRate = ViewBag.ManualRate; 
    
    decimal currentRate = ViewBag.Mode switch {
        "EURO" => ViewBag.Rate?.EurBcvRate ?? 0m,
        "BCV" => ViewBag.Rate?.BcvRate ?? 0m,
        "PARALLEL" => ViewBag.Rate?.ParaleloRate ?? 0m,
        _ => barberManualRate > 0 ? barberManualRate.Value : (ViewBag.Rate?.BcvRate ?? 0m) 
    };
}

<div class="max-w-md mx-auto pb-10">
    <!-- Encabezado tipo Móvil -->
    <div class="flex flex-col gap-1 py-4 mb-2">
        <div class="flex items-center gap-4">
            <a href="/admin/dashboard" class="text-slate-700 hover:text-slate-900">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            </a>
            <h1 class="text-[19px] font-semibold tracking-tight text-slate-800">Configuración Bimonetaria</h1>
        </div>
        <div class="ml-10 flex flex-col gap-1 relative w-56 mt-1" id="salonDropdownContainer">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Salón:</span>
            
            <button type="button" id="salonDropdownBtn" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg block w-full p-2 font-medium shadow-sm transition-colors flex justify-between items-center hover:bg-slate-100">
                <span class="truncate">@ViewBag.TiendaName</span>
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            
            <!-- Menú Desplegable -->
            <div id="salonDropdownMenu" class="absolute top-[100%] left-0 w-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-50 hidden">
                <div class="p-2 border-b border-slate-100">
                    <input type="text" id="salonSearchInput" class="w-full text-xs p-1.5 border border-slate-200 rounded-md focus:outline-none focus:border-blue-500" placeholder="Buscar salón...">
                </div>
                <div class="max-h-48 overflow-y-auto" id="salonList">
                    @foreach (var b in ViewBag.AllTiendas)
                    {
                        <div class="salon-item text-xs p-2 hover:bg-slate-50 cursor-pointer text-slate-700 @(b.Id == ViewBag.TiendaId ? "font-bold bg-slate-50 text-blue-600" : "")" data-id="@b.Id" data-name="@b.Name.ToLower()">
                            @b.Name
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tarjeta Principal -->
    <div class="rounded-[24px] border border-slate-200/80 bg-white shadow-sm overflow-hidden mb-8 mt-2">
        
        <!-- Header de la tarjeta -->
        <div class="p-6 pb-4 flex flex-col items-center">
            <div id="mode-badge" class="self-start mb-2 px-3 py-1 rounded-full text-[11px] font-semibold @modeColor flex items-center gap-1.5 transition-colors">
                <div class="h-1.5 w-1.5 rounded-full currentColor bg-current"></div>
                <span>@modeLabel</span>
            </div>
            
            <h2 id="display-rate" class="text-[40px] font-bold tracking-tight text-slate-900 mt-2">Bs. @currentRate.ToString("N2")</h2>
            <p id="display-desc" class="text-[13px] text-slate-500 font-medium">
                1 @(ViewBag.Mode == "EURO" ? "EUR" : "USD") = @currentRate.ToString("N2") VES
            </p>
        </div>

        <div class="px-6 py-2">
            <div class="h-px w-full bg-slate-100"></div>
        </div>

        <!-- Controles -->
        <div class="p-6 pt-4">
            <div class="flex justify-between items-center mb-1">
                <h3 class="font-bold text-slate-800 text-[15px]">Auto-sincronizar tasa</h3>
                
                <!-- Toggle -->
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="autoSyncToggle" class="sr-only peer" @(isAuto ? "checked" : "")>
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                </label>
            </div>
            <p class="text-[13px] text-slate-500 mb-5">Actualizar según tasa oficial del día</p>

            <!-- Modo Manual -->
            <div id="manualControls" class="@(isAuto ? "hidden" : "") flex items-end gap-3 mt-4">
                <div class="flex-1 bg-slate-50 rounded-xl p-3 border border-slate-100 relative focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500">
                    <label class="text-[11px] text-slate-500 font-medium absolute top-2 left-3">Tasa Manual (Bs. por $1)</label>
                    <div class="flex items-center mt-3">
                        <span class="text-slate-800 font-bold mr-1">Bs.</span>
                        <input type="number" id="manualRateInput" value="@currentRate.ToString("0.00")" class="bg-transparent border-none p-0 focus:ring-0 text-slate-800 font-bold w-full" step="0.01">
                    </div>
                </div>
                <button id="btnSaveManual" class="bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl px-5 h-[58px] shadow-sm transition-colors">
                    Guardar
                </button>
            </div>

            <!-- Modo Auto (Radios) -->
            <div id="autoControls" class="@(isAuto ? "" : "hidden") space-y-2.5">
                
                <!-- Opción Euro -->
                <label class="flex items-center justify-between p-4 rounded-xl border @(ViewBag.Mode == "EURO" ? "border-blue-300 bg-blue-50/50" : "border-slate-200 bg-white") cursor-pointer transition-colors hover:bg-slate-50">
                    <div class="flex items-center gap-3">
                        <input type="radio" name="autoRateType" value="EURO" data-rate="@(ViewBag.Rate?.EurBcvRate)" @(ViewBag.Mode == "EURO" ? "checked" : "") class="w-5 h-5 text-blue-600 border-slate-300 focus:ring-blue-500">
                        <span class="font-semibold text-slate-800 text-[15px]">Euro BCV (€)</span>
                    </div>
                    <span class="text-[13px] text-blue-600 font-semibold">Bs. @(ViewBag.Rate?.EurBcvRate.ToString("N2") ?? "0.00") por €1</span>
                </label>

                <!-- Opción Oficial BCV -->
                <label class="flex items-center justify-between p-4 rounded-xl border @(ViewBag.Mode == "BCV" ? "border-blue-300 bg-blue-50/50" : "border-slate-200 bg-white") cursor-pointer transition-colors hover:bg-slate-50">
                    <div class="flex items-center gap-3">
                        <input type="radio" name="autoRateType" value="BCV" data-rate="@(ViewBag.Rate?.BcvRate)" @(ViewBag.Mode == "BCV" ? "checked" : "") class="w-5 h-5 text-blue-600 border-slate-300 focus:ring-blue-500">
                        <span class="font-semibold text-slate-800 text-[15px]">Dólar Oficial BCV ($)</span>
                    </div>
                    <span class="text-[13px] text-blue-600 font-semibold">Bs. @(ViewBag.Rate?.BcvRate.ToString("N2") ?? "0.00") por $1</span>
                </label>

                <!-- Opción Paralelo -->
                <label class="flex items-center justify-between p-4 rounded-xl border @(ViewBag.Mode == "PARALLEL" ? "border-blue-300 bg-blue-50/50" : "border-slate-200 bg-white") cursor-pointer transition-colors hover:bg-slate-50">
                    <div class="flex items-center gap-3">
                        <input type="radio" name="autoRateType" value="PARALLEL" data-rate="@(ViewBag.Rate?.ParaleloRate)" @(ViewBag.Mode == "PARALLEL" ? "checked" : "") class="w-5 h-5 text-blue-600 border-slate-300 focus:ring-blue-500">
                        <span class="font-semibold text-slate-800 text-[15px]">Dólar Paralelo ($)</span>
                    </div>
                    <span class="text-[13px] text-slate-500 font-medium">Bs. @(ViewBag.Rate?.ParaleloRate.ToString("N2") ?? "0.00") por $1</span>
                </label>
            </div>
        </div>
    </div>

    <!-- Panel de Resultados de la API -->
    <h3 class="text-[11px] font-bold text-slate-500 tracking-widest uppercase mb-3 ml-2">RESULTADO DE LA API (TESTS)</h3>
    
    <div class="rounded-[24px] border border-slate-200/80 bg-slate-900 shadow-sm overflow-hidden p-5">
        <p class="text-slate-400 text-xs mb-3">Aquí verás la respuesta real del backend cada vez que selecciones una opción o guardes la configuración manual para este salón.</p>
        <pre id="apiConsole" class="text-emerald-400 text-[11px] font-mono whitespace-pre-wrap break-all min-h-[100px]">// Esperando acción...</pre>
    </div>
</div>

@section Scripts {
    <script>
        const tiendaId = parseInt('@ViewBag.TiendaId') || 0;
        const toggle = document.getElementById('autoSyncToggle');
        const manualControls = document.getElementById('manualControls');
        const autoControls = document.getElementById('autoControls');
        const manualRateInput = document.getElementById('manualRateInput');
        const btnSaveManual = document.getElementById('btnSaveManual');
        const apiConsole = document.getElementById('apiConsole');
        
        // UI Elements
        const badge = document.getElementById('mode-badge');
        const badgeText = badge.querySelector('span');
        const displayRate = document.getElementById('display-rate');
        const displayDesc = document.getElementById('display-desc');

        function updateUIAndSendRequest(mode, rate, isManual = false) {
            // Update Card
            displayRate.textContent = `Bs. ${parseFloat(rate).toFixed(2)}`;
            displayDesc.textContent = `1 ${mode === 'EURO' ? 'EUR' : 'USD'} = ${parseFloat(rate).toFixed(2)} VES`;
            
            // Update Badge
            badge.className = `self-start mb-2 px-3 py-1 rounded-full text-[11px] font-semibold flex items-center gap-1.5 transition-colors`;
            if (isManual) {
                badge.classList.add('text-blue-600', 'bg-blue-50');
                badgeText.textContent = 'Manual';
            } else if (mode === 'EURO') {
                badge.classList.add('text-indigo-600', 'bg-indigo-50');
                badgeText.textContent = 'Euro BCV (€)';
            } else if (mode === 'BCV') {
                badge.classList.add('text-emerald-600', 'bg-emerald-50');
                badgeText.textContent = 'Dólar Oficial BCV ($)';
            } else {
                badge.classList.add('text-amber-600', 'bg-amber-50');
                badgeText.textContent = 'Dólar Paralelo ($)';
            }

            // Call API
            apiConsole.textContent = '// Enviando petición POST a /admin/dev-tests/save-mode...\n// Datos: ' + JSON.stringify({ tiendaId, mode, manualRate: isManual ? parseFloat(rate) : null });
            apiConsole.className = "text-amber-400 text-[11px] font-mono whitespace-pre-wrap break-all min-h-[100px]";

            fetch('/admin/dev-tests/save-mode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tiendaId: tiendaId, mode: mode, manualRate: isManual ? parseFloat(rate) : null })
            })
            .then(res => res.json())
            .then(data => {
                apiConsole.className = "text-emerald-400 text-[11px] font-mono whitespace-pre-wrap break-all min-h-[100px]";
                apiConsole.textContent = JSON.stringify(data, null, 2);
            })
            .catch(err => {
                apiConsole.className = "text-red-400 text-[11px] font-mono whitespace-pre-wrap break-all min-h-[100px]";
                apiConsole.textContent = '// Error de red:\n' + err.message;
            });
        }

        toggle.addEventListener('change', function() {
            if (this.checked) {
                manualControls.classList.add('hidden');
                autoControls.classList.remove('hidden');
                
                // Select currently checked radio
                const activeRadio = document.querySelector('input[name="autoRateType"]:checked') || document.querySelector('input[name="autoRateType"][value="BCV"]');
                activeRadio.checked = true;
                activeRadio.dispatchEvent(new Event('change'));
            } else {
                autoControls.classList.add('hidden');
                manualControls.classList.remove('hidden');
                // Trigger manual update
                updateUIAndSendRequest('MANUAL', manualRateInput.value, true);
            }
        });
        
        btnSaveManual.addEventListener('click', () => {
            updateUIAndSendRequest('MANUAL', manualRateInput.value, true);
        });

        // Efecto visual para los radio buttons y API call
        const radios = document.querySelectorAll('input[name="autoRateType"]');
        radios.forEach(radio => {
            radio.addEventListener('change', function() {
                // Quitar highlight a todos
                document.querySelectorAll('input[name="autoRateType"]').forEach(r => {
                    const label = r.closest('label');
                    label.classList.remove('border-blue-300', 'bg-blue-50/50');
                    label.classList.add('border-slate-200', 'bg-white');
                });
                
                // Agregar highlight al seleccionado
                const label = this.closest('label');
                label.classList.remove('border-slate-200', 'bg-white');
                label.classList.add('border-blue-300', 'bg-blue-50/50');

                // Update UI and API
                if (toggle.checked) {
                    updateUIAndSendRequest(this.value, this.dataset.rate, false);
                }
            });
        });
        // Custom Dropdown Logic
        const dropdownBtn = document.getElementById('salonDropdownBtn');
        const dropdownMenu = document.getElementById('salonDropdownMenu');
        const searchInput = document.getElementById('salonSearchInput');
        const salonItems = document.querySelectorAll('.salon-item');
        
        dropdownBtn.addEventListener('click', () => {
            dropdownMenu.classList.toggle('hidden');
            if (!dropdownMenu.classList.contains('hidden')) {
                searchInput.focus();
            }
        });

        document.addEventListener('click', (e) => {
            if (!document.getElementById('salonDropdownContainer').contains(e.target)) {
                dropdownMenu.classList.add('hidden');
            }
        });

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            salonItems.forEach(item => {
                const name = item.dataset.name;
                if (name.includes(term)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        });

        salonItems.forEach(item => {
            item.addEventListener('click', () => {
                const id = item.dataset.id;
                window.location.href = '?tiendaId=' + id;
            });
        });
    </script>
}
